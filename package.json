{
  "name": "kase-corporate-actions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:chain": "node --env-file-if-exists=.env.local --import tsx scripts/chain-smoke.ts",
    "prepare:deployment": "tsx scripts/prepare-deployment.ts",
    "keeper": "node --env-file-if-exists=.env.local --import tsx scripts/keeper.ts",
    "deploy:devnet": "node --env-file-if-exists=.env.local --import tsx scripts/deploy.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.md"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "buffer": "^6.0.3",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
